# Description: 环境配置（Nuxt 惯例 NUXT_* 命名；客户端暴露的走 NUXT_PUBLIC_*）
# 后端 API 地址（SSR 服务端直连）
NUXT_API_BASE=http://10.10.2.222:5426

# 正式站点地址（canonical）
NUXT_PUBLIC_BASE_URL=http://localhost:7364

# 预览服务端口：与 devServer.port 保持一致（nuxi preview 读取 NITRO_PORT/PORT）
NITRO_PORT=7364
PORT=7364

# # 读取运行时环境，支持自定义域名与 HTTPS 证书路径（社交登录需要自定义域名 + HTTPS）
# # 开启 HTTPS 时取消注释 NUXT_HTTPS_KEY / NUXT_HTTPS_CERT，并按需设置 NUXT_DOMAIN 与端口
# # pnpm dev --public-url https://jiaopengzi.com
# NUXT_DOMAIN = "jiaopengzi.com"
# NUXT_HTTPS_KEY = ".cert/cert.key"
# NUXT_HTTPS_CERT = ".cert/cert.pem"
# NUXT_CLIENT_HTTP_PORT=80
# NUXT_CLIENT_HTTPS_PORT=443
# # 消除 “You might need `NODE_TLS_REJECT_UNAUTHORIZED=0` environment variable to make https work.” 警告
# NODE_TLS_REJECT_UNAUTHORIZED=1

# 默认 0.0.0.0 以绑定所有本地 IP 地址
NUXT_DOMAIN = "0.0.0.0"

# 前端服务端口
NUXT_CLIENT_HTTP_PORT=7364
NUXT_CLIENT_HTTPS_PORT=443

# 前端地址（显式设置时优先于 NUXT_DOMAIN/端口自动推导；留空自动生成）
NUXT_BASE_URL=

# 最大硬件并发数（分片上传哈希 Worker 上限，经 runtimeConfig.public 桥接）
NUXT_MAX_NAVIGATOR_HARDWARE_CONCURRENCY=10

# 版本信息（scripts/set-env-version.js 在 dev/build 前自动更新；经 runtimeConfig.public 暴露给客户端）
