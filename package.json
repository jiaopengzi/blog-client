    "private": true,
    "type": "module",
    "scripts": {
        "dev": "nuxi dev",
        "dev:fresh": "nuxi cleanup && nuxi dev",
        "build": "node --no-deprecation ./node_modules/nuxt/bin/nuxt.mjs build",
        "preview": "nuxi preview",
        "postinstall": "nuxt prepare",
        "type-check": "vue-tsc --noEmit -p tsconfig.nuxt.json --composite false && vue-tsc --noEmit -p tsconfig.server.json --composite false",
