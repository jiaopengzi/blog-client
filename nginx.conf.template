# ============================================================================
# blog-client 生产 nginx 主配置模板(nuxt4 SSR 单容器双进程架构的边缘层)
#
# 模板机制: 占位符 ${NGINX_SERVER_NAME} / ${NUXT_API_BASE} 由 docker-entrypoint.sh
# 在容器启动时用 envsubst 白名单替换(只替换这两个变量, 不碰 $host 等 nginx 运行时
# 变量), 生成 /etc/nginx/nginx.conf 后经 nginx -t 校验再启动.
#
# 环境变量(均可在 docker run -e 覆盖, 默认值见 Dockerfile 运行阶段 ENV):
# - NGINX_SERVER_NAME: server_name 域名(默认 jiaopengzi.com)
# - NUXT_API_BASE: 后端上游地址, nginx 代理与 node SSR 直连复用同一来源保证一致
#   (默认 http://blog-server:5426, 需与后端容器在同一自定义 docker 网络)
#
# 容器内验证配置命令(需先做与 entrypoint 相同的替换; 验证容器无 ssl 证书, nginx -t
# 报证书文件缺失即代表语法已通过——nginx 先完成配置解析才会去加载证书):
#   NGINX_SERVER_NAME=jiaopengzi.com NUXT_API_BASE=http://127.0.0.1:5426 \
#     sudo docker run --rm -e NGINX_SERVER_NAME -e NUXT_API_BASE \
#       -v $(pwd)/nginx.conf.template:/etc/nginx/nginx.conf.template \
#       nginx:1.31.6-alpine sh -c "envsubst '\${NGINX_SERVER_NAME} \${NUXT_API_BASE}' \
#         < /etc/nginx/nginx.conf.template > /etc/nginx/nginx.conf && nginx -t"
#
# nuxt4 迁移说明(相对 spa 项目 nginx.conf 的四处必要修改, 其余逐行保持一致):
# (1) location / 由 spa 的 try_files $uri $uri/ /index.html 改为反向代理到容器内
#     node SSR 进程(nuxt 是服务端渲染, 页面 HTML 由 node 实时生成, 不存在静态
#     index.html 入口);
# (2) 静态资源长缓存正则新增 _nuxt 与 fonts 目录(nuxt 构建产物在 /_nuxt/ 且文件名
#     带 hash, 自托管字体在 /fonts/, 均适合 1y immutable 策略);
# (3) 删除 spa 的 location ~* \.html$ 块——其 try_files 回退目标 /index.html 在 nuxt
#     的 public 目录不存在, 旧 .html 链接请求会触发内部重定向循环(500); 现此类请求
#     落到 location / 由 node 处理, nuxt 的 catch-all 路由渲染 404 页(与 spa 的
#     vue-router 404 行为等价);
# (4) 静态资源 root 保持镜像惯例的 /usr/share/nginx/html: 构建期先将镜像自带欢迎页
#     (index.html / 50x.html)清空, 再填入 nitro 产物 public(镜像内静态资源只保留
#     这一份, .output/public 为指向本目录的 symlink, node SSR 与 nginx 共读; 外围
#     工具 blog-tool 依赖该目录).
# ============================================================================

# location 匹配优先级(本配置依赖, 从高到低):
# (1) 精确匹配: location = /abc
# (2) ^~ 前缀匹配: 命中即停止, 不再进入正则, location ^~ /abc
# (3) 正则匹配: 按声明顺序从上到下, location ~ /abc(区分大小写) 或 ~* (不区分)
# (4) 普通前缀匹配: 最长前缀优先, location /abc

# 工作进程数按 CPU 核心数自动设置, 提升并发能力
worker_processes auto;

# pid 路径固定 /tmp, 确保容器内非 root 运行时也有权限写入
pid /tmp/nginx.pid;

events {
    # 每个 worker 的最大连接数
    worker_connections 1024;

    # Linux 高性能 epoll 事件模型 + 一次 accept 多个新连接
    use epoll;
    multi_accept on;
}

http {
    include mime.types;
    default_type application/octet-stream;

    # 高效文件传输(sendfile)与长连接保持 120s
    sendfile on;
    keepalive_timeout 120;

    # 压缩策略: gzip_static 优先直发 nitro compressPublicAssets 构建期产出的 .gz
    # 预压缩文件(需配置在 gzip on 之前); 未命中再动态压缩, 仅压 >1KB 的文本类响应,
    # 级别 6 为压缩率/CPU 折中; gzip_proxied any 使代理响应同样参与压缩,
    # gzip_vary 让中间层按 Accept-Encoding 区分缓存
    gzip_static on;
    gzip on;
    gzip_min_length 1024;
    gzip_buffers 4 16k;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
    gzip_vary on;
    gzip_proxied any;

    # 上传(媒体/分片)大小上限 100MB
    client_max_body_size 100M;

    # 隐藏 Nginx 版本号, 防信息泄露
    server_tokens off;

    # 请求审计已由后端统一记录, nginx 不重复输出每条访问日志; 仅保留 warn 及更高
    # 等级错误到 Docker stderr, 便于发现代理和静态资源异常
    access_log off;
    error_log /dev/stderr warn;

    # 基础安全响应头: 防点击劫持(禁止跨站 iframe 嵌入)/ 旧版浏览器 XSS 过滤器 /
    # 防 MIME 嗅探(如把 .txt 当 JS 执行)/ 控制 Referer 发送策略防敏感信息泄露
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    # 传输优化: tcp_nopush 配合 sendfile 攒满包再发(cork), tcp_nodelay 关闭 Nagle
    # 让小包立即发出, 两者针对的场景不同可同时开启
    tcp_nopush on;
    tcp_nodelay on;

    # 客户端请求缓冲区: 请求体 16k / 请求头 1k / 超长请求头 4x4k
    client_body_buffer_size 16k;
    client_header_buffer_size 1k;
    large_client_header_buffers 4 4k;

    # 代理缓冲(响应/请求两侧)统一在 http 级全局关闭, 此前为逐 location 重复配置:
    # - 响应侧 proxy_buffering off: nginx 默认把上游响应读入内存缓冲, 超过
    #   proxy_buffers 即写 proxy_temp 临时文件并输出 "an upstream response is
    #   buffered to a temporary file" warn; 本站各代理响应(SSR HTML / sitemap.xml /
    #   上传媒体 / API JSON)均无 nginx 层缓存诉求, 关闭后改为边收边转发, 消除该类
    #   warn 与临时文件 IO;
    # - 请求侧 proxy_request_buffering off: 默认先把整个请求体读入内存, 超过
    #   client_body_buffer_size 即写 client_temp 并输出 "a client request body is
    #   buffered to a temporary file" warn(触发源: 外部扫描器对 WordPress 接口的
    #   大请求体 POST, 以及合法的 admin 大文件上传), 关闭后请求体边收边转发给后端,
    #   不再落盘.
    # 全局关闭无副作用的前提: 本配置 proxy_pass 均为单上游直连地址(非 upstream 组),
    # 不存在跨上游重试; 配置内也无 proxy_cache/proxy_store 依赖响应缓冲. 页面代理
    # (location /)另行只放行 GET/HEAD, 见该 location 内注释.
    proxy_buffering off;
    proxy_request_buffering off;

    # 旧网址重定向映射(map 在请求匹配时按需查表, 不影响性能;
    # 通配 include 使 redirects.map 文件可选, 不存在时 nginx 不会报错)
    map $uri $redirect_uri {
        default "";
        include /etc/nginx/redirects*.map;
    }

    # HTTP:80 server, 仅做 301 跳转 HTTPS
    server {
        listen 80;
        listen [::]:80;

        server_name ${NGINX_SERVER_NAME};

        charset utf-8;

        # 运行期错误只可能来自扫描器畸形请求(如向 80 端口发 TLS 握手包), 丢弃运行期
        # 错误日志避免刷屏 docker logs; 启动/配置级错误仍由 http 级 error_log
        # (/dev/stderr warn)输出, 不受此处影响
        error_log /dev/null crit;

        location / {
            return 301 https://$host$request_uri;
        }
    }

    # HTTPS:443 server, 对外服务入口(HTTP/2)
    server {
        listen 443 ssl;
        listen [::]:443 ssl;

        http2 on;

        server_name ${NGINX_SERVER_NAME};

        charset utf-8;

        # TLS: 证书/密钥由部署挂载到 /etc/nginx/ssl; 仅允许 TLSv1.2/1.3 与 ECDHE
        # 现代加密套件, 不强制服务端首选套件(交客户端协商); 共享会话缓存 10m +
        # 会话超时 10m, 减少重复完整握手
        ssl_certificate /etc/nginx/ssl/cert.pem;
        ssl_certificate_key /etc/nginx/ssl/cert.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
        ssl_prefer_server_ciphers off;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 10m;

        # 旧网址 301 重定向(匹配 redirects.map 中的映射; server 级 if 只含 return, 安全用法)
        if ($redirect_uri != "") {
            return 301 $redirect_uri;
        }

        # 本站不是 WordPress, 外部扫描器持续 POST /wp-json/batch/v1(wp batch 撞库)
        # 等接口; 444 不回响应直接断连, return 444 不读取请求体, 攻击流量不再进入
        # 代理链路(此前行为: 请求体超 16k 写 client_temp 产生 warn, 再代理到 node
        # 渲染无意义的 404); 本站不存在以 /wp- 开头的路由, 对合法流量零影响
        location ^~ /wp- {
            return 444;
        }

        # 同源防御 PHP 入口探测(xmlrpc.php / wp-login.php 等以 .php 结尾);
        # 正则 location 优先于普通前缀匹配(/api/ /sitemap /), 本站不存在任何 .php 路由
        location ~* \.php$ {
            return 444;
        }

        # sitemap 反代到后端(上游地址由 entrypoint 按 NUXT_API_BASE 替换; sitemap 由
        # 后端生成, node 侧 routeRules 的同规则仅为 dev/preview 形态兜底)
        location /sitemap {
            proxy_pass ${NUXT_API_BASE}/api/v1/sitemap;

            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Connection "";

            # 不走缓存
            add_header Cache-Control "no-store, no-cache, must-revalidate";
        }

        # nginx 健康状态检查端点(直连返回 200; add_header 需在 return 之前,
        # 否则部分 nginx 版本不生效)
        location = /nginx-health {
            access_log off;
            add_header Content-Type text/plain;
            return 200 "healthy\n";
        }

        # === 缓存策略开始 ===

        # favicon.ico 是 admin 保存 app-option 时经 node 的 /internal/favicon-sync 落盘的
        # 镜像文件(内容随站点配置变化), 不适用下方静态资源的 1y immutable 长缓存, 单独给
        # 短缓存; 精确匹配优先级高于下方正则, 文件不存在时 nginx 404(不回退 node,
        # 与旧 SPA 静态行为一致)
        location = /favicon.ico {
            root /usr/share/nginx/html;
            # 260916-02: favicon 缺失时不再向 error_log 写 open() failed 噪音(404 响应行为不变)
            log_not_found off;
            # server/routes/favicon.ico.ts 的 max-age=3600 对齐
            expires 1h;
            add_header Cache-Control "public";
        }

        # VERSION 探活文件(内容为构建时写入的 git tag, 每次发版变化且文件名固定不带 hash).
        # 260916-05: 管理台 dashboard 运行时拉取同源 /VERSION 做版本对比, 此前该请求落入
        # 下方 location / 反代 node, 响应无 Cache-Control, 浏览器按 Last-Modified 启发式缓存
        # (DevTools 显示 from disk cache), 发版后 dashboard 展示陈旧版本号; 精确匹配单独给
        # no-cache(每次带 ETag/Last-Modified 协商, 未变化时 304), 并由 nginx 静态直出不再代理 node
        location = /VERSION {
            root /usr/share/nginx/html;
            # 与上方 favicon 的噪音治理同因: 文件由镜像构建保证存在, 缺失时不写 error_log
            log_not_found off;
            add_header Cache-Control "no-cache";
        }

        # 缓存构建产物与指定目录(_nuxt|static|assets|fonts)下的静态资源文件一年,
        # 同时匹配根目录下的 .ico .svg 文件
        # (_nuxt 文件名带内容 hash 永不变更, fonts 为自托管字体, 均适合 immutable)
        location ~* ^/(?:(?:_nuxt|static|assets|fonts)/.*\.(?:js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|otf|webp|avif|mp4|webm|pdf)|[^/]+\.(ico|svg))$ {
            root /usr/share/nginx/html;
            # 260916-02: 扫描器/旧 SPA 缓存页持续探测不存在的静态资源(/static/js/sendgrid.js、
            # /assets/env.js、.js.js 拼接路径等), 此类 404 属预期行为, 不写 open() failed 到
            # error_log 刷噪音(404 响应行为不变, access_log 本就全局 off)
            log_not_found off;
            expires 1y;
            add_header Cache-Control "public, immutable";
            # 260926-03: nginx 的 add_header 继承规则——location 内出现任何 add_header 即
            # 不再继承 http 级的 4 个安全头, 显式补回 nosniff(静态资源是防 MIME 嗅探的
            # 主场景; PVE113 实测修复前无此头, 修复后带 always 对 4xx 也生效)
            add_header X-Content-Type-Options "nosniff" always;
        }

        # API 中的上传的静态资源缓存一年(直接代理后端, 不经 node)
        location ~* ^/api/(v1/)?(uploads)/.+\.(png|jpg|jpeg|gif|ico|webp|svg|pdf|mp4|webm|ts)$ {
            proxy_pass ${NUXT_API_BASE};

            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Connection "";

            expires 1y;
            add_header Cache-Control "public, immutable";
            # 260926-03: 同上方静态正则, 补回 nosniff——uploads 代理用户上传内容且白名单
            # 含 svg(可内嵌脚本), 是 MIME 嗅探防御最关键的 location
            add_header X-Content-Type-Options "nosniff" always;
        }
        # === 缓存策略结束 ===

        # Nitro 服务端内部接口(浏览器端 admin 保存后的 POST 通知):
        # /internal/cache-invalidate 清 swr 渲染缓存, /internal/favicon-sync 同步 favicon
        # 落盘. bug 260926-01: 此前落入下方 location / 的"仅 GET/HEAD"规则被 return 444
        # 直接断连, 生产 HTTPS+HTTP/2 下浏览器报 ERR_HTTP2_PROTOCOL_ERROR(无任何响应),
        # 两接口始终未生效(本地 preview 无 nginx 层, POST 直达 node, 故无法复现);
        # 更长前缀 location 优先于 location / 匹配(^~ 同时跳过后续正则 location),
        # POST /internal/** 从此处代理到 node SSR 进程; 鉴权由接口自身完成(转发调用方
        # Authorization 到后端校验 LoginAdmin), nginx 层不做重复鉴权
        location ^~ /internal/ {
            proxy_pass http://127.0.0.1:7364;

            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

            # 告知 node 本次请求的原始协议与主机, 保持与页面代理一致(备接口后续需要)
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;

            # favicon-sync 涉及服务端向外拉取文件, 超时与页面代理对齐
            proxy_read_timeout 120;
            proxy_connect_timeout 120;
            proxy_send_timeout 120;
        }

        # 前端应用配置(nuxt4 SSR)
        # 页面 HTML 由容器内 node 进程(.output/server/index.mjs, 端口 7364, 与开发端口统一)实时渲染,
        # 未被上方静态规则命中的请求(页面路由 / _payload.json / _ipx 图片处理 等)
        # 全部代理给 node; HTML 响应头(node 侧控制)不含长缓存, 每次请求均为最新渲染
        location / {
            # 页面路由只接受 GET/HEAD(表单登录/上传等全部业务请求走 /api/ 反代后端);
            # 扫描器 POST / 、POST /?rest_route=... 等落到此处, 此前请求体先被 nginx 写 client_temp
            # 产生 warn 再代理到 node 渲染 404; 现 return 444 直接断连且不读请求体,
            # 同时消除该类 warn 与无意义的 SSR 渲染(if in location 内只含 return, 属安全用法)
            if ($request_method !~ ^(GET|HEAD)$) {
                return 444;
            }

            proxy_pass http://127.0.0.1:7364;

            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

            # 告知 node 本次请求的原始协议与主机(SSR 生成 canonical / og:url 等需要),
            # 否则 node 侧只能看到 http://127.0.0.1:7364 会推导出错误的站点地址
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;

            # 代理超时统一 120s, 覆盖默认 60s 避免 SSR 慢查询被截断
            proxy_read_timeout 120;
            proxy_connect_timeout 120;
            proxy_send_timeout 120;
        }

        # 后端服务配置
        # 上游地址由 entrypoint 按 NUXT_API_BASE 替换(默认 docker 服务名 blog-server:5426,
        # 需在同一自定义网络下, 否则用 docker run -e NUXT_API_BASE=... 指向宿主机内网地址)
        location /api/ {
            proxy_pass ${NUXT_API_BASE}/api/;

            proxy_http_version 1.1;

            # 清空发往后端的 Connection 头: HTTP/1.1 下连接默认持久, 无该头即默认
            # keepalive 语义(nginx 官方对上游 keepalive 的标准写法). 本站 /api 为纯
            # REST 无 WebSocket, 原spa 遗留的 Upgrade/Connection "upgrade" 两行已于
            # 260926 移除(HTTP/2 前端下 $http_upgrade 恒为空, 属死配置且语义错误)
            proxy_set_header Connection "";

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

            # 代理超时统一 120s, 与页面代理对齐
            proxy_read_timeout 120;
            proxy_connect_timeout 120;
            proxy_send_timeout 120;

            # 不走缓存
            add_header Cache-Control "no-store, no-cache, must-revalidate";
        }
    }
}
