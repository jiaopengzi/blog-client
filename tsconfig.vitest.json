 */

/**
 * 补充说明:
 * include 含 .vue; 不引入 unplugin 生成的 components.d.ts(计划坑位 7).
 * DOM 全局类型由继承的 tsconfig.nuxt.json 的 lib("DOM"/"DOM.Iterable") 提供;
 * 测试使用 jsdom 运行时, 无需在 types 中额外声明 "jsdom".
 */

{
    "extends": "./tsconfig.nuxt.json",
    "files": [".nuxt/nuxt.d.ts", ".nuxt/nuxt.node.d.ts"],
    "include": ["env.d.ts", "vitest.config.ts", "vitest.setup.ts", "oxlint.config.ts", "src/types/**/*.d.ts", "src/**/*.ts", "src/**/*.vue"],
    "exclude": ["dist", "node_modules", "coverage", ".nuxt", ".output"],
    "compilerOptions": {
        "composite": false,
        "types": ["node"]
    }
}
